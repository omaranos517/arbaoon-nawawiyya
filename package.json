{
  "name": "arbaoon-nawawiyya",
  "version": "0.1.0",
  "description": "الأربعون النووية",
  "desktopName": "arbaoon-nawawiyya.desktop",
  "author": "Omar Anoss",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write --experimental-cli src/",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"electron .\"",
    "build:web": "vite build --mode web",
    "build:app": "vite build --mode app",
    "gen": "node scripts/gen-packaging.mjs",
    "android": "npm run build:app && node scripts/gen-capacitor.mjs && npx capacitor-assets generate --android --iconBackgroundColor '#f8f5ec' --splashBackgroundColor '#f8f5ec' && cap sync android",
    "electron:win": "npm run build:app && electron-builder --win --config electron-builder.config.mjs",
    "electron:linux": "npm run build:app && electron-builder --linux flatpak --config electron-builder.config.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "prettier": "3.9.6",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
